# ARBOR environment variables — COPY to `.env` and fill in real values.
# `.env` is gitignored. Secrets NEVER enter the repo (Section 0, rule 8).
#
# Phase 0 only needs the Supabase vars below to be real; the rest are
# placeholders that later phases will use. `src/index.ts` boots without them
# but reports which integrations are unconfigured.

# --- App ---
NODE_ENV=development
APP_NAME=ARBOR

# --- Supabase (Phase 0–1: system of record) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice / telephony (Phase 2) ---
# Platform: ElevenLabs Agents (Mike-directed, supersedes the Vapi default).
# ELEVENLABS_BRIDGE_SECRET is a secret WE mint (any long random string); the
# ElevenLabs agent sends it to our custom-LLM bridge so only our agent can
# reach the receptionist endpoint.
ELEVENLABS_API_KEY=
ELEVENLABS_BRIDGE_SECRET=
# The receptionist brain (Claude) behind the voice bridge.
ANTHROPIC_API_KEY=
# Legacy alternative platform (D4) — unused while ElevenLabs is the pick.
VAPI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Workspace (Phase 1+: Drive, Calendar, Gmail) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_MAPS_API_KEY=
# The live "ARBOR Clients" root folder in the owner's Drive (per-property
# folders are created under this). Created in Phase 1.
ARBOR_DRIVE_ROOT_FOLDER_ID=1O76sL4tkQ33xDFTmoorayMT2pZwd6WAT

# --- Alerts to Mike (Phase 2: emergency push/SMS) ---
OWNER_ALERT_PHONE=

# --- Ops app (§8 admin surface) ---
# Access key for the phone app + /api routes. Any long random string; Mike
# enters it once per device. With this unset, /api fails closed as soon as a
# database is connected (customer data never sits on an open endpoint).
APP_ACCESS_KEY=
