# ARBOR environment variables — COPY to `.env` and fill in real values.
# `.env` is gitignored. Secrets NEVER enter the repo (Section 0, rule 8).
#
# Phase 0 only needs the Supabase vars below to be real; the rest are
# placeholders that later phases will use. `src/index.ts` boots without them
# but reports which integrations are unconfigured.

# --- App ---
NODE_ENV=development
APP_NAME=ARBOR

# --- Supabase (Phase 0–1: system of record) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice / telephony (Phase 2: Vapi + Twilio) ---
VAPI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Workspace (Phase 1+: Drive, Calendar, Gmail) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_MAPS_API_KEY=

# --- Alerts to Mike (Phase 2: emergency push/SMS) ---
OWNER_ALERT_PHONE=
