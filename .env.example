# ── Arbo CRM environment ───────────────────────────────────────────────────
# Copy to .env for local dev, and set the same keys in Vercel → Settings →
# Environment Variables for production. VITE_* values are exposed to the browser
# (safe: anon key + URL only); everything else is server-only.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Browser auth client:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server (serverless functions). SUPABASE_URL/ANON default to the VITE_* values
# if omitted; the service role key is REQUIRED and must never be prefixed VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin access (required) ─────────────────────────────────────────────────
# Comma-separated allowlist of admin emails (union'd with the crm_admins table).
CRM_ADMIN_EMAILS=artistreeofvirginia@gmail.com

# ── AI receptionist (optional) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email notifications via Resend (optional) ───────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_FROM=Arbo CRM <crm@yourdomain.com>
NOTIFY_TO=artistreeofvirginia@gmail.com
APP_URL=https://arbo.yourdomain.com

# ── Google (Gmail + Calendar sync, optional) ────────────────────────────────
# One OAuth client + a refresh token for the business Google account, with
# scopes: https://www.googleapis.com/auth/gmail.modify and
#         https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary
# Which emails count as inbound inquiries (Gmail search syntax):
GMAIL_QUERY=is:unread newer_than:7d in:inbox
GMAIL_PROCESSED_LABEL=Arbo/Processed

# ── Cron protection (required if using Vercel Cron) ─────────────────────────
# Vercel automatically sends "Authorization: Bearer $CRON_SECRET" to cron paths.
CRON_SECRET=generate-a-long-random-string
